{
  "id": "bio-lab",
  "name": "Biology Wing",
  "ambientSound": "ambient-hum",
  "lighting": "flicker",
  "narrativeOnEnter": "Biology wing. Chemicals and overturned equipment. Specimen vault still locked.",
  "particles": { "type": "smoke", "density": 0.4 },

  "hotspots": [
    {
      "id": "bio-fridge",
      "type": "container",
      "label": "Specimen Fridge",
      "x": 4, "y": 16, "w": 14, "h": 60,
      "cursor": "pointer",
      "action": { "type": "toggle-container", "objectId": "bio-fridge" },
      "contents": [
        {
          "id": "bio-research-note",
          "type": "item",
          "label": "Research Note",
          "x": 5, "y": 32, "w": 10, "h": 12,
          "visibleWhen": { "objectState": "bio-fridge", "equals": "open" },
          "action": { "type": "inspect", "text": "SPECIMEN LOG — DR. REEVES\n\nSample B-7: accelerated growth. Vault and office on lockdown.\n\nDirector's safe override: {{director-safe-code}}\n\nNote: 'Do NOT leave this in the fridge. — K'" }
        }
      ]
    },
    {
      "id": "bio-vault-lock",
      "type": "puzzle-trigger",
      "label": "Specimen Vault — Circuit Lock",
      "x": 33, "y": 18, "w": 22, "h": 46,
      "cursor": "zoom-in",
      "action": { "type": "open-puzzle", "puzzleId": "bio-switch" },
      "contents": []
    },
    {
      "id": "bio-key-box",
      "type": "container",
      "label": "Maintenance Key Box",
      "x": 33, "y": 64, "w": 22, "h": 16,
      "cursor": "pointer",
      "condition": { "puzzleSolved": "bio-switch" },
      "action": { "type": "toggle-container", "objectId": "bio-key-box" },
      "lockedMessage": "The key box is magnetically sealed — must be linked to the vault circuit lock.",
      "contents": [
        {
          "id": "maintenance-key",
          "type": "pickupable",
          "label": "Maintenance Key",
          "x": 35, "y": 68, "w": 8, "h": 8,
          "visibleWhen": { "objectState": "bio-key-box", "equals": "open" },
          "action": { "type": "pick-up", "itemId": "maintenance-key" }
        }
      ]
    },
    {
      "id": "bio-microscope",
      "type": "inspect",
      "label": "Microscope & Incident Board",
      "x": 62, "y": 28, "w": 34, "h": 50,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "Microscope slide shows hexagonal cells — crystalline, engineered.\nSticky note: 'DO NOT LOOK DIRECTLY. — Dr. Chen'\n\nIncident board nearby: Bio Wing B containment breach.\nPersonnel status — Dr. Chen: UNKNOWN. K. Reiss: REDACTED." },
      "contents": []
    },
    {
      "id": "bio-back-door",
      "type": "door",
      "label": "← Back to Main Lab",
      "x": 0, "y": 12, "w": 4, "h": 70,
      "cursor": "pointer",
      "action": { "type": "navigate", "to": "main-lab" },
      "contents": []
    }
  ]
}
