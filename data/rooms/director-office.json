{
  "id": "director-office",
  "name": "Director's Office",
  "ambientSound": "ambient-hum",
  "lighting": "normal",
  "narrativeOnEnter": "Director's office. Suspiciously intact. A wall safe and a desk worth checking.",
  "particles": { "type": "dust", "density": 0.3 },

  "hotspots": [
    {
      "id": "director-desk",
      "type": "container",
      "label": "Director's Desk",
      "x": 28, "y": 46, "w": 38, "h": 30,
      "cursor": "pointer",
      "action": { "type": "toggle-container", "objectId": "director-desk" },
      "contents": [
        {
          "id": "director-memo",
          "type": "item",
          "label": "Internal Memo",
          "x": 30, "y": 55, "w": 14, "h": 12,
          "visibleWhen": { "objectState": "director-desk", "equals": "open" },
          "action": { "type": "inspect", "text": "EYES ONLY — From: Harkins\n\nPhase 2 complete. Facility self-seals in 90 min.\nDo NOT proceed with Phase 3. Six people on a station is not acceptable.\n\nP.S. I have kept a copy of everything. Consider this my insurance." }
        }
      ]
    },
    {
      "id": "director-safe-lock",
      "type": "puzzle-trigger",
      "label": "Wall Safe — Keypad",
      "x": 4, "y": 22, "w": 14, "h": 22,
      "cursor": "zoom-in",
      "action": { "type": "open-puzzle", "puzzleId": "director-safe" },
      "contents": []
    },
    {
      "id": "director-safe-door",
      "type": "container",
      "label": "Wall Safe",
      "x": 4, "y": 44, "w": 14, "h": 18,
      "cursor": "pointer",
      "condition": { "puzzleSolved": "director-safe" },
      "action": { "type": "toggle-container", "objectId": "director-safe-door" },
      "lockedMessage": "The safe is locked. There must be a keypad nearby.",
      "contents": [
        {
          "id": "office-id-card",
          "type": "pickupable",
          "label": "Emergency ID Card",
          "x": 5, "y": 48, "w": 8, "h": 8,
          "visibleWhen": { "objectState": "director-safe-door", "equals": "open" },
          "action": { "type": "pick-up", "itemId": "office-id-card" }
        },
        {
          "id": "director-safe-note",
          "type": "item",
          "label": "Sealed Envelope",
          "x": 5, "y": 57, "w": 8, "h": 8,
          "visibleWhen": { "objectState": "director-safe-door", "equals": "open" },
          "action": { "type": "inspect", "text": "EMERGENCY ACCESS — MAINTENANCE HATCH OVERRIDE\n\nThis ID card grants bypass to the maintenance tunnel.\n\nBack of card: 'Use it. Get out. — K'" }
        }
      ]
    },
    {
      "id": "director-office-decor",
      "type": "inspect",
      "label": "Portrait & Bookshelf",
      "x": 40, "y": 6, "w": 57, "h": 72,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "Portrait: DIRECTOR RAYMOND HARKINS. Someone drew an X over his eyes.\nSigned beneath: 'He knew from the start. — K.R.'\n\nBookshelf holds a hidden binder — AXIOM PROJECT HELIOS.\n47 names. All from Blackwood Psychiatric Institute, 1972.\nMargin note in red ink: 'Necessary.'" },
      "contents": []
    },
    {
      "id": "director-back-door",
      "type": "door",
      "label": "← Back to Server Room",
      "x": 0, "y": 12, "w": 4, "h": 70,
      "cursor": "pointer",
      "action": { "type": "navigate", "to": "server-room" },
      "contents": []
    }
  ]
}
