{
  "id": "utility-corridor",
  "name": "Utility Corridor",
  "ambientSound": "ambient-hum",
  "lighting": "flicker",
  "narrativeOnEnter": "Narrow service corridor. Power junction flickering at the far end.",
  "particles": { "type": "smoke", "density": 0.5 },

  "hotspots": [
    {
      "id": "utility-warning",
      "type": "inspect",
      "label": "Warning Notice",
      "x": 4, "y": 16, "w": 18, "h": 28,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "HIGH VOLTAGE\nBypass chips in lower compartment.\nInsert chip into laser control port to override the grid." },
      "contents": []
    },
    {
      "id": "utility-burn-mark",
      "type": "inspect",
      "label": "Burn Mark",
      "x": 28, "y": 26, "w": 22, "h": 34,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "Scorch mark from a melted cable junction.\n\nScratched in soot: 'K. REISS WAS HERE — 03:40'\n'I burned the relay. Both extraction routes are dead now.'" },
      "contents": []
    },
    {
      "id": "power-junction-trigger",
      "type": "puzzle-trigger",
      "label": "Power Junction — Frequency Stabiliser",
      "x": 60, "y": 18, "w": 22, "h": 42,
      "cursor": "zoom-in",
      "action": { "type": "open-puzzle", "puzzleId": "power-frequency" },
      "contents": []
    },
    {
      "id": "chip-compartment",
      "type": "container",
      "label": "Bypass Chip Compartment",
      "x": 60, "y": 60, "w": 22, "h": 18,
      "cursor": "pointer",
      "condition": { "puzzleSolved": "power-frequency" },
      "action": { "type": "toggle-container", "objectId": "chip-compartment" },
      "lockedMessage": "The compartment is locked — stabilise the junction frequency above first.",
      "contents": [
        {
          "id": "bypass-chip",
          "type": "pickupable",
          "label": "Bypass Chip",
          "x": 61, "y": 64, "w": 10, "h": 10,
          "visibleWhen": { "objectState": "chip-compartment", "equals": "open" },
          "action": { "type": "pick-up", "itemId": "bypass-chip" }
        }
      ]
    },
    {
      "id": "utility-back",
      "type": "door",
      "label": "← Back to Security Hub",
      "x": 0, "y": 12, "w": 4, "h": 70,
      "cursor": "pointer",
      "action": { "type": "navigate", "to": "security-hub" },
      "contents": []
    }
  ]
}
