{
  "id": "bw-records-vault",
  "name": "Records Vault",
  "ambientSound": "ambient-hum",
  "lighting": "flicker",
  "narrativeOnEnter": "Floor-to-ceiling filing cabinets. One has a symbol lock — a key hangs from its handle.",
  "particles": { "type": "dust", "density": 0.4 },

  "hotspots": [
    {
      "id": "bw-to-directors-office",
      "type": "door",
      "label": "Director's Office",
      "x": 80, "y": 15, "w": 14, "h": 70,
      "cursor": "pointer",
      "condition": { "hasItem": "bw-director-key" },
      "action": { "type": "navigate", "to": "bw-directors-office" },
      "lockedMessage": "A heavy locked door — Director Harlan's office. You need his key.",
      "contents": []
    },
    {
      "id": "bw-back-to-treatment",
      "type": "door",
      "label": "Back to Treatment Room",
      "x": 0, "y": 15, "w": 8, "h": 70,
      "cursor": "pointer",
      "action": { "type": "navigate", "to": "bw-treatment-room" },
      "contents": []
    },
    {
      "id": "bw-cipher-cabinet-trigger",
      "type": "puzzle-trigger",
      "label": "Symbol Cabinet",
      "x": 55, "y": 15, "w": 22, "h": 42,
      "cursor": "zoom-in",
      "action": { "type": "open-puzzle", "puzzleId": "bw-records-cipher" },
      "contents": []
    },
    {
      "id": "bw-records-cabinet-a",
      "type": "container",
      "label": "Filing Cabinet A",
      "x": 10, "y": 20, "w": 16, "h": 60,
      "cursor": "pointer",
      "action": { "type": "toggle-container", "objectId": "bw-records-cabinet-a" },
      "contents": [
        {
          "id": "bw-harlan-memo",
          "type": "item",
          "label": "Director's Memo",
          "x": 12, "y": 30, "w": 12, "h": 14,
          "clueSlot": "bw-harlan-memo",
          "visibleWhen": { "objectState": "bw-records-cabinet-a", "equals": "open" },
          "action": { "type": "inspect", "text": "MEMO — DR. HARLAN\nBlackwood founded: 1972.\n\nOffice key is in this vault. Symbol sequence: Cross, Moon, Star, Eye.\nMy safe code: 1972.\n\nAddendum: 'I kept copies of everything AXIOM sent me. — E. Harlan'" }
        }
      ]
    },
    {
      "id": "bw-records-cabinet-b",
      "type": "container",
      "label": "Filing Cabinet B",
      "x": 30, "y": 20, "w": 14, "h": 60,
      "cursor": "pointer",
      "action": { "type": "toggle-container", "objectId": "bw-records-cabinet-b" },
      "contents": [
        {
          "id": "bw-incident-report",
          "type": "item",
          "label": "Incident Report",
          "x": 32, "y": 30, "w": 10, "h": 14,
          "visibleWhen": { "objectState": "bw-records-cabinet-b", "equals": "open" },
          "action": { "type": "inspect", "text": "INCIDENT REPORT — 1972\n\nPatient 07 accessed the ward gate (code: 4031) and vault. Returned to solitary.\n\nHarlan's annotation: 'She handed me a list. 47 names. She told the truth.\nEleven days later, I gave her the tunnel key. — E. Harlan'" }
        }
      ]
    },
    {
      "id": "bw-director-key-pickup",
      "type": "pickupable",
      "label": "Director's Office Key",
      "x": 55, "y": 60, "w": 22, "h": 20,
      "cursor": "pointer",
      "condition": { "puzzleSolved": "bw-records-cipher" },
      "lockedMessage": "The key cage is locked. Solve the symbol cabinet to release it.",
      "lockedAction": { "type": "open-puzzle", "puzzleId": "bw-records-cipher" },
      "action": { "type": "pick-up", "itemId": "bw-director-key" },
      "contents": []
    },
    {
      "id": "delta-bw-records-vault",
      "type": "delta-collect",
      "label": "Δ",
      "x": 5, "y": 4, "w": 3, "h": 4,
      "cursor": "pointer",
      "action": { "type": "collect-delta", "deltaId": "delta-bw-records-vault" },
      "contents": []
    }
  ]
}
