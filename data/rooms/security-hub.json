{
  "id": "security-hub",
  "name": "Security Hub",
  "ambientSound": "ambient-server",
  "lighting": "flicker-fast",
  "narrativeOnEnter": "Security station. Dead CCTV screens. Access control panel still running on backup power.",
  "particles": { "type": "smoke", "density": 0.3 },

  "hotspots": [
    {
      "id": "cctv-console",
      "type": "inspect",
      "label": "CCTV Console",
      "x": 18, "y": 14, "w": 38, "h": 32,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "All monitors frozen at 03:41. Cameras dead.\n\nCam 9 — blurry figure sprinting for the exit.\n\nSticky note: 'IF CAMERAS GO DOWN — CHECK BIO WING. DO NOT GO ALONE. — Torres'" },
      "contents": []
    },
    {
      "id": "guard-logbook",
      "type": "inspect",
      "label": "Guard's Logbook",
      "x": 4, "y": 46, "w": 13, "h": 28,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "GUARD LOG — M. Torres\n\n03:41 — Power anomaly. All cameras offline.\n\nFinal entry: 'Emergency corridor needs a security pass. I left mine in the locker. Panel code is in the access control unit.'" },
      "contents": []
    },
    {
      "id": "security-panel-trigger",
      "type": "puzzle-trigger",
      "label": "Access Control Panel",
      "x": 74, "y": 14, "w": 16, "h": 30,
      "cursor": "zoom-in",
      "action": { "type": "open-puzzle", "puzzleId": "security-panel" },
      "contents": []
    },
    {
      "id": "security-locker",
      "type": "container",
      "label": "Security Locker",
      "x": 74, "y": 44, "w": 16, "h": 32,
      "cursor": "pointer",
      "condition": { "puzzleSolved": "security-panel" },
      "action": { "type": "toggle-container", "objectId": "security-locker" },
      "lockedMessage": "The locker is electronically sealed — it must be linked to the access control panel above.",
      "contents": [
        {
          "id": "security-pass",
          "type": "pickupable",
          "label": "Security Pass",
          "x": 75, "y": 50, "w": 8, "h": 10,
          "visibleWhen": { "objectState": "security-locker", "equals": "open" },
          "action": { "type": "pick-up", "itemId": "security-pass" }
        }
      ]
    },
    {
      "id": "security-hub-back",
      "type": "door",
      "label": "← Back to Server Room",
      "x": 0, "y": 12, "w": 4, "h": 70,
      "cursor": "pointer",
      "action": { "type": "navigate", "to": "server-room" },
      "contents": []
    },
    {
      "id": "security-hub-to-utility",
      "type": "door",
      "label": "Utility Corridor →",
      "x": 91, "y": 12, "w": 7, "h": 70,
      "cursor": "pointer",
      "action": { "type": "navigate", "to": "utility-corridor" },
      "contents": []
    },
    {
      "id": "delta-security-hub",
      "type": "delta-collect",
      "label": "Δ",
      "x": 60, "y": 90, "w": 3, "h": 4,
      "cursor": "pointer",
      "action": { "type": "collect-delta", "deltaId": "delta-security-hub" },
      "contents": []
    }
  ]
}
