{
  "id": "lab-entry",
  "name": "Lab Entry",
  "ambientSound": "ambient-hum",
  "lighting": "flicker",
  "narrativeOnEnter": "The security door slams shut behind you. Emergency lighting casts long shadows across the tiled floor. You need to find a way deeper into the lab.",
  "particles": { "type": "dust", "density": 0.4 },

  "hotspots": [
    {
      "id": "entry-door-mainlab",
      "type": "door",
      "label": "Main Lab Door",
      "x": 58, "y": 12, "w": 20, "h": 70,
      "cursor": "pointer",
      "condition": { "puzzleSolved": "entry-keypad" },
      "action": { "type": "navigate", "to": "main-lab" },
      "lockedMessage": "The door is sealed. There must be an access keypad nearby.",
      "contents": []
    },
    {
      "id": "entry-keypad",
      "type": "puzzle-trigger",
      "label": "Access Keypad",
      "x": 81, "y": 32, "w": 10, "h": 20,
      "cursor": "zoom-in",
      "action": { "type": "open-puzzle", "puzzleId": "entry-keypad" },
      "contents": []
    },
    {
      "id": "entry-drawer",
      "type": "container",
      "label": "Metal Drawer",
      "x": 4, "y": 65, "w": 22, "h": 22,
      "cursor": "pointer",
      "action": { "type": "toggle-container", "objectId": "entry-drawer" },
      "contents": [
        {
          "id": "sticky-note",
          "type": "item",
          "label": "Sticky Note",
          "x": 6, "y": 72, "w": 7, "h": 8,
          "clueSlot": "sticky-note",
          "visibleWhen": { "objectState": "entry-drawer", "equals": "open" },
          "action": { "type": "inspect", "text": "A scrawled sticky note reads:\n\n'New keypad code — IT changed it again.\nCheck the server diagram for the password too.\n— Dr. Chen'\n\nBelow it, barely visible: {{keypad-code}}" }
        },
        {
          "id": "screwdriver",
          "type": "pickupable",
          "label": "Screwdriver",
          "x": 13, "y": 72, "w": 5, "h": 8,
          "clueSlot": "screwdriver",
          "visibleWhen": { "objectState": "entry-drawer", "equals": "open" },
          "action": { "type": "pick-up", "itemId": "screwdriver" }
        }
      ]
    },
    {
      "id": "entry-vent",
      "type": "container",
      "label": "Ceiling Vent",
      "x": 42, "y": 2, "w": 14, "h": 9,
      "cursor": "pointer",
      "condition": { "hasItem": "screwdriver" },
      "action": { "type": "toggle-container", "objectId": "entry-vent" },
      "lockedMessage": "The vent cover is screwed shut. You need a tool to open it.",
      "contents": [
        {
          "id": "keycard-a",
          "type": "pickupable",
          "label": "Access Keycard A",
          "x": 44, "y": 3, "w": 6, "h": 5,
          "clueSlot": "keycard-a",
          "visibleWhen": { "objectState": "entry-vent", "equals": "open" },
          "action": { "type": "pick-up", "itemId": "keycard-a" }
        }
      ]
    },
    {
      "id": "entry-computer",
      "type": "inspect",
      "label": "Broken Terminal",
      "x": 26, "y": 40, "w": 18, "h": 28,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "The monitor flickers, showing nothing but a crash log:\n\n[CRITICAL] BIOS error 0xDEAD\n[CRITICAL] Network stack failure\n[WARN] Backup power: 12%\n\nThe terminal is completely dead. Someone didn't want anyone using this." },
      "contents": []
    },
    {
      "id": "entry-note-wall",
      "type": "inspect",
      "label": "Warning Notice",
      "x": 4, "y": 18, "w": 16, "h": 28,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "ARCADIA RESEARCH — BIOHAZARD PROTOCOL ACTIVE\n\nAll personnel must check out via security terminal.\nUnauthorised access will trigger full lockdown.\n\nAlarm sequence initiates automatically.\nSecurity response time: 60 seconds.\n\n— Management" },
      "contents": []
    }
  ]
}
