{
  "id": "lab-entry",
  "name": "Lab Entry",
  "ambientSound": "ambient-hum",
  "lighting": "flicker",
  "narrativeOnEnter": "Security door sealed behind you. Emergency lights only. Find a way deeper.",
  "particles": { "type": "dust", "density": 0.4 },

  "hotspots": [
    {
      "id": "entry-door-mainlab",
      "type": "door",
      "label": "Main Lab Door",
      "x": 58, "y": 12, "w": 20, "h": 70,
      "cursor": "pointer",
      "condition": { "all": [
        { "puzzleSolved": "entry-keypad" },
        { "hasItem": "keycard-a" }
      ] },
      "action": { "type": "navigate", "to": "main-lab" },
      "lockedMessage": "The door is sealed.",
      "lockedMessages": [
        "The door is sealed. Find the access keypad.",
        "Keypad light is green — swipe your access keycard to proceed."
      ],
      "contents": []
    },
    {
      "id": "entry-keypad",
      "type": "puzzle-trigger",
      "label": "Access Keypad",
      "x": 81, "y": 32, "w": 10, "h": 20,
      "cursor": "zoom-in",
      "action": { "type": "open-puzzle", "puzzleId": "entry-keypad" },
      "contents": []
    },
    {
      "id": "entry-drawer",
      "type": "container",
      "label": "Metal Drawer",
      "x": 4, "y": 65, "w": 22, "h": 22,
      "cursor": "pointer",
      "action": { "type": "toggle-container", "objectId": "entry-drawer" },
      "contents": [
        {
          "id": "sticky-note",
          "type": "item",
          "label": "Sticky Note",
          "x": 6, "y": 72, "w": 7, "h": 8,
          "clueSlot": "sticky-note",
          "visibleWhen": { "objectState": "entry-drawer", "equals": "open" },
          "action": { "type": "inspect", "text": "Sticky note: 'New keypad code — {{keypad-code}}\nServer password on the wiring diagram. — Dr. Chen'" }
        },
        {
          "id": "screwdriver",
          "type": "pickupable",
          "label": "Screwdriver",
          "x": 13, "y": 72, "w": 5, "h": 8,
          "clueSlot": "screwdriver",
          "visibleWhen": { "objectState": "entry-drawer", "equals": "open" },
          "action": { "type": "pick-up", "itemId": "screwdriver" }
        }
      ]
    },
    {
      "id": "entry-vent",
      "type": "container",
      "label": "Ceiling Vent",
      "x": 42, "y": 2, "w": 14, "h": 9,
      "cursor": "pointer",
      "condition": { "hasItem": "screwdriver" },
      "action": { "type": "toggle-container", "objectId": "entry-vent" },
      "lockedMessage": "The vent cover is screwed shut. You need a tool to open it.",
      "contents": [
        {
          "id": "keycard-a",
          "type": "pickupable",
          "label": "Access Keycard A",
          "x": 44, "y": 3, "w": 6, "h": 5,
          "clueSlot": "keycard-a",
          "visibleWhen": { "objectState": "entry-vent", "equals": "open" },
          "action": { "type": "pick-up", "itemId": "keycard-a" }
        }
      ]
    },
    {
      "id": "entry-computer",
      "type": "inspect",
      "label": "Broken Terminal",
      "x": 26, "y": 40, "w": 18, "h": 28,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "Monitor flickers. One message on screen:\n\n> GET OUT. THE TUNNEL IS REAL.\n> — P" },
      "contents": []
    },
    {
      "id": "entry-note-wall",
      "type": "inspect",
      "label": "Warning Notice",
      "x": 4, "y": 18, "w": 16, "h": 28,
      "cursor": "zoom-in",
      "action": { "type": "inspect", "text": "BIOHAZARD PROTOCOL ACTIVE\n\nUnauthorised access triggers full lockdown.\nAlarm response: 60 seconds.\n\nSmall print: 'Property of AXIOM BIOTECH GROUP.'" },
      "contents": []
    },
    {
      "id": "delta-lab-entry",
      "type": "delta-collect",
      "label": "Δ",
      "x": 93, "y": 88, "w": 3, "h": 4,
      "cursor": "pointer",
      "action": { "type": "collect-delta", "deltaId": "delta-lab-entry" },
      "contents": []
    }
  ]
}
